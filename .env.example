# --- LLM ---
GROQ_API_KEY=your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
READ_ONLY_MODE=true
APP_DB_URL=sqlite:///./app.db

# --- Optional target MySQL (use a READ-ONLY DB user!) ---
TARGET_DB_URL=mysql+pymysql://readonly_user:password@mysql:3306/demo
QUERY_TIMEOUT_SECONDS=10
MAX_ROWS=500
